# --- Core security ---
APP_ENV=dev
SECRET_KEY=
ALLOWED_HOSTS=
COOKIE_SECURE=0
TRUSTED_PROXY=0

# --- Network ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
# Comma-separated origins allowed to call the API from a browser
# e.g. https://your-app.vercel.app (Vercel rewrites normally make this unnecessary)
CORS_ORIGINS=

# --- Telegram alerts ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# --- Camera/stream source ---
RTSP_STREAM_URL=rtsp://username:password@192.168.1.100:554/stream1
VIDEO_PATH=./theft.mp4

# --- Models ---
MODELS_DIR=
MODEL_PATH=yolo11m-pose.pt
MODEL_ENGINE=yolo11m-pose.engine

# --- Detection tuning (overridable from the Settings tab) ---
SEC_TO_FAINT=30
FRAME_SKIP=2
ESTIMATED_FPS=15
MODEL_CONF=0.25
MODEL_IMGSZ=480
MSG_COOLDOWN=30

# --- Credentials ---
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

# --- Dispatch ---
EMERGENCY_NUMBER=100

# --- Runtime mode ---
# 1 = run the live CV engine + Telegram bot (needs torch/GPU) — this machine or GPU cloud box
# 0 = API-only shell mode (Vercel static frontend + Render API) — no engine, offline snapshot/stream
RUN_ENGINE=1

# --- Runtime data locations (Docker overrides point these at the volume) ---
DATABASE_PATH=sentineliq.db
EVIDENCE_DIR=evidence
MEDIA_DIR=media